{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TDisplay Studio",
  "version": "0.1.0",
  "identifier": "dev.tdisplay.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TDisplay Studio",
        "width": 780,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "licenses/reui.txt",
      "licenses/maple-mono.txt",
      "licenses/iconpark.txt"
    ]
  }
}
